# Ryudai Tools 設定ファイル
# cp .env.example .env して編集する

# サーバー設定
PORT=8080
WEBCLASS_BASE_URL=https://webclass.cc.u-ryukyu.ac.jp/webclass
# 外部から見たこのアプリの URL（ChatGPT などとの OAuth 連携に必須。末尾の / は不要）
# PUBLIC_BASE_URL=https://ryudai-tools.example.com
# 旧ドメイン（カンマ区切り）。ここへのアクセスは PUBLIC_BASE_URL へ 308 で転送する
# LEGACY_HOSTS=daigaku-hack.example.com
# 教務情報システム（シラバス検索・履修登録）。ログイン画面: https://tiglon.jim.u-ryukyu.ac.jp/portal/Login.aspx
KYOMU_BASE_URL=https://tiglon.jim.u-ryukyu.ac.jp/portal

# DB パス（SQLite ファイル）
# ローカル実行・Docker 共通で ./data/ 以下に置く（Go が自動でディレクトリを作成する）
DB_PATH=./data/daihack.db

# オプション: 自分の WebClass / 教務アカウントだけセッションを自動更新する
# WEBCLASS_USERNAME=
# WEBCLASS_PASSWORD=

# 時限開始時刻（琉球大学デフォルト値）
# 変更する場合のみコメント解除
# PERIOD_1=08:30
# PERIOD_2=10:20
# PERIOD_3=12:50
# PERIOD_4=14:40
# PERIOD_5=16:20
# PERIOD_6=18:00
# PERIOD_7=19:40
# PERIOD_8=21:10
